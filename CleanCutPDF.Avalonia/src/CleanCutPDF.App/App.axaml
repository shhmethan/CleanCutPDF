<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CleanCutPDF.App.ViewModels"
             xmlns:views="using:CleanCutPDF.App.Views"
             x:Class="CleanCutPDF.App.App"
             RequestedThemeVariant="Light">

  <!-- Explicit view-model → view mapping (no reflection, trimming friendly). -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:InboxViewModel">
      <views:InboxView />
    </DataTemplate>
    <DataTemplate DataType="vm:SplitRenameViewModel">
      <views:SplitRenameView />
    </DataTemplate>
    <DataTemplate DataType="vm:RenameOnlyViewModel">
      <views:RenameOnlyView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CleanCutPDF/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
