<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CleanCutPDF.App.ViewModels"
             x:Class="CleanCutPDF.App.Views.InboxView"
             x:DataType="vm:InboxViewModel">

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="Inbox" Classes="page-title" />
      <TextBlock Text="PDFs waiting to be processed. Drag files anywhere onto the window to add them."
                 Classes="muted" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="Open PDFs…" Command="{Binding OpenPdfsCommand}" Classes="accent" />
      <Button Content="Close Selected" Command="{Binding CloseSelectedCommand}" />
      <Button Content="Cancel Loading" Command="{Binding CancelImportCommand}"
              IsVisible="{Binding IsImporting}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectionSummary}" Classes="muted"
               FontSize="12" Margin="2,0,0,6" />

    <Grid>
      <Border Classes="card" Padding="4">
        <!-- Horizontal scrolling keeps long filenames and workspace labels readable. -->
        <ListBox x:Name="DocumentList"
                 ItemsSource="{Binding Documents}"
                 SelectedItems="{Binding SelectedDocuments}"
                 SelectionMode="Multiple"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="📄" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="NoWrap"
                             Classes="muted" Classes.error="{Binding IsFailed}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4"
                             VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" IsHitTestVisible="False">
        <TextBlock Text="📂" FontSize="42" HorizontalAlignment="Center" />
        <TextBlock Text="No PDFs yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Click Open PDFs… or drag and drop one or more PDF files here."
                   Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
