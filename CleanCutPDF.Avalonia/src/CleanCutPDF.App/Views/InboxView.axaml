<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CleanCutPDF.App.ViewModels"
             x:Class="CleanCutPDF.App.Views.InboxView"
             x:DataType="vm:InboxViewModel">

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="Inbox" Classes="page-title" />
      <TextBlock Text="PDFs waiting to be processed. Drag files anywhere onto the window to add them. Folders here only organize the list; your files are never moved."
                 Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemSpacing="8" LineSpacing="8">
      <Button Content="Open PDFs…" Command="{Binding OpenPdfsCommand}" Classes="accent" />
      <Button Content="New Folder…" Command="{Binding NewFolderCommand}" />
      <Button Content="Change Workspace…" Command="{Binding ChangeWorkspaceCommand}" />
      <Button Content="Move to Folder…" Command="{Binding MoveToFolderCommand}" />
      <Button Content="Close Selected" Command="{Binding CloseSelectedCommand}" />
      <Button Content="Cancel Loading" Command="{Binding CancelImportCommand}" IsVisible="{Binding IsImporting}" />
      <Button Content="📄 SPLIT HERE Sheet…" Command="{Binding SaveSplitHereSheetCommand}"
              ToolTip.Tip="Save a printable SPLIT HERE separator page" />
    </WrapPanel>

    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectionSummary}" Classes="muted"
               FontSize="{DynamicResource AppFontSizeSmall}" Margin="2,0,0,6" TextWrapping="Wrap" />

    <Grid>
      <Border Classes="card" Padding="4">
        <!-- Horizontal scrolling keeps long filenames and workspace labels readable. -->
        <ListBox x:Name="DocumentList"
                 ItemsSource="{Binding Rows}"
                 SelectedItems="{Binding SelectedRows}"
                 SelectionMode="Multiple"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OnOpenMenuClick" />
              <Separator />
              <MenuItem Header="Change Workspace for Selected…" Command="{Binding ChangeWorkspaceCommand}" />
              <MenuItem Header="Move Selected to Folder…" Command="{Binding MoveToFolderCommand}" />
              <MenuItem Header="Close Selected PDF(s)" Command="{Binding CloseSelectedCommand}" />
              <Separator />
              <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}" />
              <MenuItem Header="Rename Folder…" Command="{Binding RenameFolderCommand}" />
              <MenuItem Header="Delete Folder…" Command="{Binding DeleteFolderCommand}" />
              <MenuItem Header="Move Folder Up" Command="{Binding MoveFolderUpCommand}" />
              <MenuItem Header="Move Folder Down" Command="{Binding MoveFolderDownCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>

          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:FolderRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <Button Content="{Binding Chevron}" Padding="4,0" MinWidth="0" Background="Transparent"
                        Command="{Binding $parent[ListBox].((vm:InboxViewModel)DataContext).ToggleFolderCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Show or hide this folder" />
                <TextBlock Text="📁" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="vm:DocumentItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="30,0,0,0">
                <TextBlock Text="📄" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="NoWrap"
                             Classes="muted" Classes.error="{Binding IsFailed}" />
                </StackPanel>
                <ProgressBar Width="70" MinWidth="0" Height="4" VerticalAlignment="Center"
                             IsVisible="{Binding IsBusy}" IsIndeterminate="{Binding IsLoading}"
                             Maximum="100" Value="{Binding DetectionPercent}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>

      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" IsHitTestVisible="False">
        <TextBlock Text="📂" FontSize="{DynamicResource AppFontSizeIcon}" HorizontalAlignment="Center" />
        <TextBlock Text="No PDFs yet" FontSize="{DynamicResource AppFontSizeHeader}" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Click Open PDFs… or drag and drop one or more PDF files here."
                   Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
