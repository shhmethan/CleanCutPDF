<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CleanCutPDF.App.ViewModels"
        x:Class="CleanCutPDF.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/favicon.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="220,*" IsEnabled="{Binding !License.IsLocked}">

      <!-- Navigation -->
      <Border Background="{DynamicResource SidebarBackground}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14" Spacing="2">
            <TextBlock Text="CleanCutPDF" FontSize="{DynamicResource AppFontSizeBrand}" FontWeight="SemiBold" />
            <TextBlock Text="Preview build" Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" />
          </StackPanel>
          <ListBox Classes="nav"
                   Background="Transparent"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Glyph}" Width="22" TextAlignment="Center" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
        <!-- Update banner: informational only, never blocks work -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.IsBannerVisible}"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Updates.BannerText}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Updates.IsInstalling}">
                <ProgressBar Width="220" Height="6" MinWidth="0" Maximum="100" Value="{Binding Updates.InstallPercent}"
                             VerticalAlignment="Center" />
                <TextBlock Text="{Binding Updates.InstallStatus}" VerticalAlignment="Center"
                           AutomationProperties.Name="Update progress" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Updates.BannerNotes}" IsVisible="{Binding !Updates.IsInstalling}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Install Update" Classes="accent" Command="{Binding Updates.InstallUpdateCommand}"
                      IsVisible="{Binding Updates.ShowInstall}" />
              <Button Content="Download…" Classes="accent" Command="{Binding Updates.OpenDownloadCommand}"
                      IsVisible="{Binding Updates.ShowDownloadLink}" />
              <Button Content="Cancel" Command="{Binding Updates.CancelInstallCommand}"
                      IsVisible="{Binding Updates.IsInstalling}" />
              <Button Content="Later" Command="{Binding Updates.DismissBannerCommand}"
                      IsVisible="{Binding !Updates.IsInstalling}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Current page (resolved through Application.DataTemplates) -->
        <ContentControl Content="{Binding CurrentPage}" />
      </DockPanel>
    </Grid>

    <!-- License lock screen: covers the app only when the license does not allow use -->
    <Border IsVisible="{Binding License.IsLocked}" Background="#B0000000">
      <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding License.Headline}" FontSize="{DynamicResource AppFontSizeBrand}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding License.Explanation}" TextWrapping="Wrap" Classes="muted" />

          <StackPanel Spacing="8" IsVisible="{Binding License.ShowKeyEntry}">
            <TextBox Text="{Binding License.KeyInput}" PlaceholderText="License key"
                     IsEnabled="{Binding !License.IsBusy}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding License.ActivateCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </StackPanel>

          <TextBlock Text="{Binding License.Message}" TextWrapping="Wrap"
                     IsVisible="{Binding License.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ProgressBar IsIndeterminate="True" Height="3" MinWidth="0" IsVisible="{Binding License.IsBusy}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Activate" Classes="accent" Command="{Binding License.ActivateCommand}"
                    IsVisible="{Binding License.ShowKeyEntry}" IsDefault="True" />
            <Button Content="Try Again" Classes="accent" Command="{Binding License.VerifyNowCommand}"
                    IsVisible="{Binding License.ShowRetry}" />
            <Button Content="Quit" Command="{Binding License.QuitCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Status bar: shows background work without blocking the window -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SidebarBackground}" Padding="12,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="80" Height="4" MinWidth="0"
                     VerticalAlignment="Center" IsVisible="{Binding Activity.IsBusy}" />
        <TextBlock Text="{Binding Activity.StatusText}" Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
