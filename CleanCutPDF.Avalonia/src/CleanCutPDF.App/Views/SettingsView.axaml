<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CleanCutPDF.App.ViewModels"
             xmlns:models="using:CleanCutPDF.Core.Models"
             xmlns:updates="using:CleanCutPDF.Core.Updates"
             x:Class="CleanCutPDF.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="900" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="Settings" Classes="page-title" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Appearance" Classes="section-title" />
          <Grid ColumnDefinitions="Auto,220" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Theme" />
            <TextBlock Grid.Row="1" Text="Color" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Color" />
            <TextBlock Grid.Row="2" Text="Font" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFont}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Font" />
            <TextBlock Grid.Row="3" Text="Text size" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Text size" />
          </Grid>
          <Button Content="Reset Font" Command="{Binding ResetFontCommand}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="Changes apply instantly to every window." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Export" Classes="section-title" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Default folder" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ExportFolderDisplay, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseExportFolderCommand}" />
            <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenExportFolderCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Behavior" Classes="section-title" />
          <CheckBox Content="Remove blank pages automatically when exporting" IsChecked="{Binding RemoveBlankPages}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" Margin="28,-4,0,4" TextWrapping="Wrap"
                     Text="Checks every exported page, including blank pages between non-blank pages. Pages with text or annotations are always kept." />
          <CheckBox Content="Make a client folder inside the export folder" IsChecked="{Binding MakeClientFolder}" />
          <CheckBox Content="Warn me when I enter a future date" IsChecked="{Binding WarnOnFutureDates}" />
          <CheckBox Content="Warn me when no SPLIT HERE pages are detected" IsChecked="{Binding WarnWhenNoSplitMarkers}" />
          <CheckBox Content="Restore open PDFs and entered values when CleanCutPDF starts" IsChecked="{Binding AutoRestoreSession}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="About" Classes="section-title" />
          <TextBlock Text="{Binding VersionText}" />
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Data folder" VerticalAlignment="Center" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding DataFolder}" VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
            <Button Grid.Column="2" Content="Open" Command="{Binding OpenDataFolderCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Keyboard shortcuts" Classes="section-title" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="Click a shortcut, then press the new key combination (Esc cancels). Ctrl+Alt+D always opens the debug console and cannot be changed." />
          <ItemsControl ItemsSource="{Binding Keybinds.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeybindRowViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="160" HorizontalContentAlignment="Center"
                          Classes.accent="{Binding IsCapturing}"
                          AutomationProperties.Name="{Binding Label, StringFormat='{}{0} shortcut'}"
                          ToolTip.Tip="Click, then press the new key combination"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Keybinds.BeginCaptureCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="✕" IsEnabled="{Binding HasGesture}"
                          AutomationProperties.Name="{Binding Label, StringFormat='Remove {0} shortcut'}"
                          ToolTip.Tip="Remove this shortcut"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Keybinds.ClearCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Keybinds.Message}" Classes="error" TextWrapping="Wrap"
                     IsVisible="{Binding Keybinds.HasMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Show Keybinds" Command="{Binding Keybinds.ShowAllCommand}" />
            <Button Content="Reset to Defaults…" Command="{Binding Keybinds.ResetAllCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Folder shortcuts" Classes="section-title" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="Folders you open often (for example Files to be Processed). They appear as buttons at the top of Split &amp; Rename." />
          <ItemsControl ItemsSource="{Binding Shortcuts.Shortcuts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:FolderShortcut">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                  <StackPanel>
                    <TextBlock>
                      <Run Text="{Binding Icon}" />
                      <Run Text=" " />
                      <Run Text="{Binding Label}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{Binding Path}" Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Open" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Shortcuts.OpenCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="Edit…" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Shortcuts.EditShortcutCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="3" Content="Remove" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Shortcuts.RemoveCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No shortcuts yet." Classes="muted" IsVisible="{Binding Shortcuts.IsEmpty}" />
          <Button Content="+ Add Folder…" Command="{Binding Shortcuts.AddCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Import from CleanCutPDF 1.x" Classes="section-title" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="Brings over your workspaces, custom fields, filename formats, notes, settings, folder shortcuts, open PDFs with their typed values, Inbox folders, and export history. CleanCutPDF 1.x data is only read, never changed." />
          <TextBlock Text="{Binding LegacyStatus}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeSmall}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Import…" Command="{Binding LegacyImport.ImportCommand}" />
            <TextBlock Text="{Binding LegacyImport.LastImportText}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Diagnostics" Classes="section-title" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="CleanCutPDF keeps a daily log of what it did and any problems (file names and actions only; no client names or field values). Logs older than 14 days are deleted automatically. If something goes wrong, send the newest log file." />
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Logs folder" VerticalAlignment="Center" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding LogsFolder}" VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
            <Button Grid.Column="2" Content="Open" Command="{Binding OpenLogsFolderCommand}" />
          </Grid>
          <CheckBox Content="Detailed logging (for troubleshooting; larger log files)"
                    IsChecked="{Binding VerboseLogging}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="License" Classes="section-title" />
          <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                IsVisible="{Binding License.HasLicense}">
            <TextBlock Text="Licensed to" />
            <TextBlock Grid.Column="1" Text="{Binding License.LicensedTo}" />
            <TextBlock Grid.Row="1" Text="Expires" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License.ExpiresText}" />
            <TextBlock Grid.Row="2" Text="Last verified" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding License.LastVerifiedText}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="The license is checked online in the background once a week. Without internet, CleanCutPDF keeps working for up to 30 days after the last successful check." />
          <TextBlock Text="{Binding License.Message}" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeSmall}"
                     IsVisible="{Binding License.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Verify Now" Command="{Binding License.VerifyNowCommand}"
                    IsVisible="{Binding License.HasLicense}" />
            <Button Content="Remove License…" Command="{Binding License.RemoveLicenseCommand}"
                    IsVisible="{Binding License.HasLicense}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Updates" Classes="section-title" />
          <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6">
            <TextBlock Text="Installed" />
            <TextBlock Grid.Column="1" Text="{Binding Updates.CurrentVersion}" />
            <TextBlock Grid.Row="1" Text="Last checked" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Updates.LastCheckedText}" />
          </Grid>
          <CheckBox Content="Check for updates every time CleanCutPDF opens (in the background)"
                    IsChecked="{Binding Updates.CheckAutomatically}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Check Now" Command="{Binding Updates.CheckNowCommand}" />
            <TextBlock Text="{Binding Updates.StatusText}" Classes="muted" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock Text="Release notes appear after the first successful update check." Classes="muted"
                     FontSize="{DynamicResource AppFontSizeSmall}" IsVisible="{Binding !Updates.ReleaseNotes.Count}" />
          <ItemsControl ItemsSource="{Binding Updates.ReleaseNotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="updates:ReleaseNotes">
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeSmall}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Reset" Classes="section-title" />
          <TextBlock Classes="muted" FontSize="{DynamicResource AppFontSizeSmall}" TextWrapping="Wrap"
                     Text="Returns every setting, all workspaces, and all custom fields to the defaults. Your license, export history, open PDFs, diagnostic logs, and keyboard shortcuts are kept, and the current files are backed up first." />
          <Button Content="Reset Settings…" Command="{Binding ResetSettingsCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
